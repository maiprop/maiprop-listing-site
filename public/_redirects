# Cloudflare Pages redirects
# Syntax: https://developers.cloudflare.com/pages/configuration/redirects/
# Note: /sitemap-dynamic.xml is served by functions/sitemap-dynamic.xml.ts
# (Pages Functions take priority over _redirects).

# Static fallback if the Function is unavailable.
/sitemap-dynamic.xml  /sitemap.xml  200

# SPA fallback — send all unmatched paths to index.html for React Router.
/*  /index.html  200
