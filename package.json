{
  "name": "maiprop-listing-site",
  "description": "MaiProp — Greek real estate listing, auction, and investment platform (Vite + React 18 + Supabase).",
  "private": true,
  "version": "1.9.8",
  "license": "UNLICENSED",
  "homepage": "https://maiprop.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/maiprop/maiprop-listing-site.git"
  },
  "packageManager": "npm@10.8.2",
  "volta": {
    "node": "20.19.5",
    "npm": "10.8.2"
  },
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10.8.0 <11"
  },
  "type": "module",
  "overrides": {
    "tmp": "^0.2.4",
    "uuid": "^14.0.0"
  },
  "overridesRationale": {
    "tmp": "@lhci/cli@0.15.1 pulls old tmp ranges through Lighthouse and inquirer/external-editor. Pin tmp above GHSA-52f5-9888-hmc6 until Lighthouse CI removes those transitive ranges.",
    "uuid": "@lhci/cli@0.15.1 still declares uuid ^8.3.1. Pin to a supported uuid release because npm deprecates uuid@10 and below."
  },
  "scripts": {
    "dev": "vite",
    "seed:users": "npx tsx scripts/seed-mock-users.ts",
    "simulate": "npx tsx scripts/simulate-platform-interactions.ts",
    "cleanup:production-fixtures": "node scripts/cleanup-production-fixtures.mjs",
    "seed:listings": "npx tsx scripts/seed-mock-listings.ts",
    "seed:professionals": "npx tsx scripts/seed-mock-professionals.ts",
    "seed:open-houses": "npx tsx scripts/seed-mock-open-houses.ts",
    "seed:new-builds": "npx tsx scripts/seed-mock-new-builds.ts",
    "seed:notifications": "npx tsx scripts/seed-mock-notifications.ts",
    "seed:listing-images": "npx tsx scripts/seed-listing-images.ts",
    "seed:demo-accounts": "npx tsx scripts/seed-demo-accounts.ts",
    "db:push": "supabase db push",
    "api-docs:copy": "node -e \"const fs=require('fs');fs.mkdirSync('public/docs',{recursive:true});fs.copyFileSync('docs/api/edge-functions.openapi.yaml','public/docs/edge-functions.openapi.yaml')\"",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:production-deploy": "node scripts/check-production-deploy.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "typecheck:remotion": "tsc --noEmit -p remotion-video/tsconfig.json",
    "check:edge-functions": "node scripts/check-edge-functions.mjs",
    "check:deployable-runtimes": "npm run typecheck && npm run typecheck:functions && npm run typecheck:remotion && npm run check:edge-functions",
    "prebuild": "npm run api-docs:copy && npm run typecheck",
    "build": "vite build",
    "compress:images": "node scripts/compress-images.mjs",
    "build:dev": "vite build --mode development",
    "check:type-debt": "node scripts/check-type-debt.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:perf": "npm run build && playwright test e2e/performance-gates.spec.ts --project=chromium",
    "test:e2e:live-smoke": "playwright test e2e/live-critical-smoke.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:deno": "node scripts/run-deno-tests.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "inventory:release": "node scripts/release-safety-inventory.mjs",
    "check:release-safety": "node scripts/release-safety-inventory.mjs --check",
    "inventory:public-functions": "node scripts/public-function-inventory.cjs --out docs/public-edge-function-inventory.json",
    "check:public-functions": "node scripts/public-function-inventory.cjs --check",
    "check:supabase-advisor": "node scripts/check-supabase-advisor.mjs",
    "check:supabase-types": "node scripts/check-supabase-types-freshness.cjs",
    "inventory:audit-coverage": "node scripts/audit-coverage-inventory.mjs",
    "check:audit-coverage": "node scripts/audit-coverage-inventory.mjs --check && vitest run src/test/criticalWorkflowProof.test.ts",
    "test:audit-coverage": "npm run test:coverage && npm run inventory:audit-coverage && npm run check:audit-coverage",
    "lint:migrations": "node scripts/check-migration-idempotency.mjs",
    "lint:migrations:chronology": "node scripts/check-migration-idempotency.mjs --check-chronology",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "i18n:scan": "i18next-scanner --config i18next-scanner.config.js",
    "prepare": "husky",
    "cap:sync:android": "node scripts/build-capacitor-android.mjs --sync-only",
    "android:web:apk": "node scripts/build-capacitor-android.mjs",
    "android:web:apk:release": "node scripts/build-capacitor-android.mjs --release",
    "android:web:apk:bundled": "node scripts/build-capacitor-android.mjs --bundled"
  },
  "dependencies": {
    "@capacitor/android": "7.6.5",
    "@capacitor/core": "7.6.5",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.53.1",
    "@supabase/supabase-js": "^2.106.2",
    "@tanstack/react-query": "^5.100.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^25.10.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "mapbox-gl": "2.15.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.2",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.76.1",
    "react-i18next": "^16.6.6",
    "react-map-gl": "^7.1.9",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@capacitor/cli": "7.6.5",
    "@cloudflare/workers-types": "^4.20260526.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.32.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@remotion/google-fonts": "^4.0.467",
    "@remotion/transitions": "^4.0.451",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "i18next-scanner": "^4.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "remotion": "^4.0.451",
    "rollup-plugin-visualizer": "^6.0.11",
    "sharp": "^0.34.5",
    "supabase": "^2.101.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^7.3.3",
    "vitest": "3.2.4",
    "ws": "8.21.0"
  }
}
