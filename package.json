{
  "name": "maiprop-listing-site",
  "description": "MaiProp — Greek real estate listing, auction, and investment platform (Vite + React 18 + Supabase).",
  "private": true,
  "version": "1.0.0",
  "license": "UNLICENSED",
  "homepage": "https://maiprop.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/maiprop/maiprop-listing-site.git"
  },
  "type": "module",
  "overrides": {
    "tmp": "^0.2.4"
  },
  "scripts": {
    "dev": "vite",
    "seed:users": "npx tsx scripts/seed-mock-users.ts",
    "simulate": "npx tsx scripts/simulate-platform-interactions.ts",
    "seed:listings": "npx tsx scripts/seed-mock-listings.ts",
    "seed:professionals": "npx tsx scripts/seed-mock-professionals.ts",
    "seed:open-houses": "npx tsx scripts/seed-mock-open-houses.ts",
    "seed:new-builds": "npx tsx scripts/seed-mock-new-builds.ts",
    "seed:notifications": "npx tsx scripts/seed-mock-notifications.ts",
    "seed:listing-images": "npx tsx scripts/seed-listing-images.ts",
    "seed:demo-accounts": "npx tsx scripts/seed-demo-accounts.ts",
    "db:push": "supabase db push",
    "api-docs:copy": "node -e \"const fs=require('fs');fs.mkdirSync('public/docs',{recursive:true});fs.copyFileSync('docs/api/edge-functions.openapi.yaml','public/docs/edge-functions.openapi.yaml')\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "prebuild": "npm run api-docs:copy && npm run typecheck",
    "build": "vite build",
    "compress:images": "node scripts/compress-images.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:deno": "deno test --allow-env --allow-net --allow-read supabase/functions/",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "i18n:scan": "i18next-scanner --config i18next-scanner.config.js"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^3.10.0",
    "@lovable.dev/cloud-auth-js": "^1.0.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/react": "^10.47.0",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-query": "^5.99.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.34.0",
    "i18next": "^25.10.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "mapbox-gl": "2.15.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.61.1",
    "react-i18next": "^16.6.6",
    "react-map-gl": "^7.1.9",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@cloudflare/workers-types": "^4.20260421.1",
    "@eslint/js": "^9.32.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^15.15.0",
    "i18next-scanner": "^4.6.0",
    "jsdom": "^29.0.2",
    "lovable-tagger": "^1.1.13",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "supabase": "^2.92.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.2",
    "vite": "^7.3.2",
    "vitest": "^3.2.4"
  }
}
