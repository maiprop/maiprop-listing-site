{
  "name": "maiprop-listing-site",
  "description": "MaiProp — Greek real estate listing, auction, and investment platform (Vite + React 18 + Supabase).",
  "private": true,
  "version": "1.12.3",
  "license": "UNLICENSED",
  "homepage": "https://portal.maiprop.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/maiprop/maiprop-listing-site.git"
  },
  "packageManager": "npm@10.8.2",
  "volta": {
    "node": "20.19.5",
    "npm": "10.8.2"
  },
  "engines": {
    "node": ">=20.19.0 <21",
    "npm": ">=10.8.0 <11"
  },
  "type": "module",
  "overrides": {
    "js-yaml": "4.2.0",
    "tmp": "^0.2.7",
    "tar": "7.5.16",
    "uuid": "^14.0.0",
    "undici": "7.28.0",
    "ws": "8.21.0"
  },
  "overridesRationale": {
    "js-yaml": "ESLint, commitlint, and LHCI utilities can pull vulnerable js-yaml ranges. Pin to 4.2.0 to cover GHSA-h67p-54hq-rp68 across transitive dev tooling.",
    "tmp": "@lhci/cli@0.15.1 pulls old tmp ranges through Lighthouse and inquirer/external-editor. Pin tmp above GHSA-ph9p-34f9-6g65 until Lighthouse CI removes those transitive ranges.",
    "tar": "@capacitor/cli pulls node-tar. Pin to 7.5.16 to cover GHSA-vmf3-w455-68vh until the upstream range is refreshed.",
    "uuid": "@lhci/cli@0.15.1 still declares uuid ^8.3.1. Pin to a supported uuid release because npm deprecates uuid@10 and below.",
    "undici": "Transitive tooling pulls undici 7.25.0, which is covered by open Dependabot advisories GHSA-vmh5-mc38-953g and GHSA-pr7r-676h-xcf6. Pin to 7.28.0 until upstream packages refresh their ranges.",
    "ws": "Lighthouse pulls ws 7.x. Pin to the current safe 8.x runtime to cover GHSA-96hv-2xvq-fx4p while keeping the direct ws dependency aligned."
  },
  "scripts": {
    "dev": "vite",
    "seed:users": "npx tsx scripts/seed-mock-users.ts",
    "simulate": "npx tsx scripts/simulate-platform-interactions.ts",
    "cleanup:production-fixtures": "node scripts/cleanup-production-fixtures.mjs",
    "cleanup:professional-fixtures": "node scripts/cleanup-professional-fixtures.mjs",
    "seed:listings": "npx tsx scripts/seed-mock-listings.ts",
    "seed:professionals": "npx tsx scripts/seed-mock-professionals.ts",
    "seed:open-houses": "npx tsx scripts/seed-mock-open-houses.ts",
    "seed:new-builds": "npx tsx scripts/seed-mock-new-builds.ts",
    "seed:notifications": "npx tsx scripts/seed-mock-notifications.ts",
    "seed:listing-images": "npx tsx scripts/seed-listing-images.ts",
    "seed:demo-accounts": "npx tsx scripts/seed-demo-accounts.ts",
    "db:push": "supabase db push",
    "api-docs:copy": "node -e \"const fs=require('fs');fs.mkdirSync('public/docs',{recursive:true});fs.copyFileSync('docs/api/edge-functions.openapi.yaml','public/docs/edge-functions.openapi.yaml')\"",
    "runtime": "node scripts/project-runtime.mjs --",
    "runtime:doctor": "node scripts/project-runtime.mjs --doctor",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:runtime:local": "node scripts/project-runtime.mjs -- npm run check:runtime",
    "check:secrets": "node scripts/check-secrets.mjs",
    "stripe:setup-catalog": "node scripts/setup-stripe-catalog.mjs",
    "check:stripe-account": "node scripts/check-stripe-account.mjs",
    "check:stripe-business-logic": "node scripts/check-stripe-business-logic.mjs",
    "check:stripe-tax-readiness": "node scripts/check-stripe-tax-readiness.mjs",
    "check:stripe-live-migration": "node scripts/check-stripe-live-migration.mjs",
    "check:production-deploy": "node scripts/check-production-deploy.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "typecheck:remotion": "tsc --noEmit -p remotion-video/tsconfig.json",
    "check:edge-functions": "node scripts/check-edge-functions.mjs",
    "check:deployable-runtimes": "npm run typecheck && npm run typecheck:functions && npm run typecheck:remotion && npm run check:edge-functions",
    "prebuild": "npm run api-docs:copy && npm run typecheck",
    "build": "vite build",
    "build:homepage-initial": "node scripts/inject-homepage-initial.mjs",
    "build:cloudflare-pages-worker": "node scripts/build-cloudflare-pages-worker.mjs",
    "compress:images": "node scripts/compress-images.mjs",
    "build:dev": "vite build --mode development",
    "check:type-debt": "node scripts/check-type-debt.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "node scripts/run-vitest-coverage.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:perf": "npm run build && playwright test e2e/performance-gates.spec.ts e2e/query-budget-gates.spec.ts --project=chromium",
    "test:e2e:live-smoke": "playwright test e2e/live-critical-smoke.spec.ts --project=chromium",
    "test:e2e:live-role-tier-matrix": "playwright test e2e/live-role-tier-matrix.spec.ts --project=chromium --workers=2",
    "test:e2e:live-ai-quota": "playwright test e2e/live-ai-quota.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:deno": "node scripts/run-deno-tests.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:load-test-contract": "node scripts/check-load-test-contract.mjs",
    "check:perf-evidence": "node scripts/perf-evidence-contract.mjs",
    "check:perf-proof": "npm run check:load-test-contract && npm run check:perf-evidence",
    "check:dependency-overrides": "node scripts/check-dependency-overrides.mjs",
    "inventory:release": "node scripts/release-safety-inventory.mjs",
    "check:release-safety": "node scripts/release-safety-inventory.mjs --check",
    "inventory:public-functions": "node scripts/public-function-inventory.cjs --out docs/public-edge-function-inventory.json",
    "check:public-functions": "node scripts/public-function-inventory.cjs --check",
    "check:supabase-advisor": "node scripts/check-supabase-advisor.mjs",
    "capture:supabase-index-stats": "node scripts/capture-supabase-index-stats.mjs",
    "check:supabase-types": "node scripts/check-supabase-types-freshness.cjs",
    "check:live-security-posture": "node scripts/check-live-security-posture.mjs",
    "check:rls-crud-matrix": "node scripts/check-rls-crud-matrix.mjs",
    "capture:rls-crud-matrix": "node scripts/capture-rls-crud-matrix.mjs",
    "capture:sentry-live-evidence": "node scripts/capture-sentry-live-evidence.mjs",
    "capture:cloudflare-admin-posture": "node scripts/capture-cloudflare-admin-posture.mjs",
    "capture:github-admin-posture": "node scripts/capture-github-admin-posture.mjs",
    "check:ecas-live-evidence": "node scripts/check-ecas-live-evidence.mjs",
    "check:github-governance": "node scripts/check-github-governance.mjs",
    "check:dr-readiness": "node scripts/check-dr-readiness.mjs",
    "check:dr-restore-proof": "node scripts/check-dr-readiness.mjs --require-successful-restore",
    "check:compliance-matrix": "node scripts/check-compliance-matrix.mjs",
    "check:dora-readiness": "node scripts/check-dora-readiness.mjs",
    "check:slsa-readiness": "node scripts/check-slsa-readiness.mjs",
    "check:wcag-coverage": "node scripts/check-wcag-coverage.mjs",
    "check:standards-readiness": "node scripts/check-standards-readiness.mjs",
    "check:openapi-coverage": "node scripts/check-openapi-coverage.mjs",
    "check:mutation-validation": "node scripts/check-mutation-validation-contract.mjs",
    "check:repo-architecture": "node scripts/check-repository-architecture.mjs",
    "check:ecas-hardening": "node scripts/check-ecas-hardening-contracts.mjs",
    "check:enterprise-readiness-basics": "node scripts/check-enterprise-readiness-basics.mjs",
    "backup:supabase:logical": "node scripts/supabase-logical-backup.mjs",
    "inventory:audit-coverage": "node scripts/audit-coverage-inventory.mjs",
    "check:audit-coverage": "node scripts/audit-coverage-inventory.mjs --check && vitest run src/test/criticalWorkflowProof.test.ts",
    "test:audit-coverage": "npm run test:coverage && npm run inventory:audit-coverage && npm run check:audit-coverage",
    "lint:migrations": "node scripts/check-migration-idempotency.mjs",
    "lint:migrations:chronology": "node scripts/check-migration-idempotency.mjs --check-chronology",
    "perf:k6": "node scripts/perf-k6-run.mjs",
    "perf:k6:smoke": "node scripts/perf-k6-run.mjs --profile smoke",
    "perf:k6:baseline": "node scripts/perf-k6-run.mjs --profile baseline_100",
    "perf:k6:growth": "node scripts/perf-k6-run.mjs --profile growth_10x",
    "perf:k6:soak": "node scripts/perf-k6-run.mjs --profile enterprise_soak",
    "lighthouse": "lhci autorun",
    "lighthouse:collect": "lhci collect",
    "lighthouse:assert": "lhci assert",
    "i18n:scan": "i18next-scanner --config i18next-scanner.config.js",
    "prepare": "husky",
    "cap:sync:android": "node scripts/build-capacitor-android.mjs --sync-only",
    "android:web:apk": "node scripts/build-capacitor-android.mjs",
    "android:web:apk:release": "node scripts/build-capacitor-android.mjs --release",
    "android:web:apk:bundled": "node scripts/build-capacitor-android.mjs --bundled"
  },
