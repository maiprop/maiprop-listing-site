{"policies" : [{"schemaname":"public","tablename":"listings","policyname":"listing_insert_quota","permissive":"PERMISSIVE","roles":["authenticated"],"cmd":"INSERT","qual":null,"with_check":"((owner_id = ( SELECT auth.uid() AS uid)) AND ( SELECT private.check_listing_quota() AS check_listing_quota) AND ((COALESCE((listing_type)::text, 'sale'::text) <> 'new_build'::text) OR ( SELECT private.has_developer_listing_access(( SELECT auth.uid() AS uid)) AS has_developer_listing_access)) AND ((project_id IS NULL) OR (( SELECT private.has_developer_listing_access(( SELECT auth.uid() AS uid)) AS has_developer_listing_access) AND (EXISTS ( SELECT 1\n   FROM projects project\n  WHERE ((project.id = listings.project_id) AND (project.owner_id = listings.owner_id) AND (project.owner_id = ( SELECT auth.uid() AS uid))))))))"}, 
