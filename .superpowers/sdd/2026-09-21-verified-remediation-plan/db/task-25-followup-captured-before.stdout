 {"schemaname":"public","tablename":"listings","policyname":"listings_update","permissive":"PERMISSIVE","roles":["authenticated"],"cmd":"UPDATE","qual":"(owner_id = ( SELECT auth.uid() AS uid))","with_check":"((owner_id = ( SELECT auth.uid() AS uid)) AND ((COALESCE((listing_type)::text, 'sale'::text) <> 'new_build'::text) OR ( SELECT private.has_developer_listing_access(( SELECT auth.uid() AS uid)) AS has_developer_listing_access)) AND ((project_id IS NULL) OR (( SELECT private.has_developer_listing_access(( SELECT auth.uid() AS uid)) AS has_developer_listing_access) AND (EXISTS ( SELECT 1\n   FROM projects project\n  WHERE ((project.id = listings.project_id) AND (project.owner_id = listings.owner_id) AND (project.owner_id = ( SELECT auth.uid() AS uid))))))))"}, 
 {"schemaname":"public","tablename":"viewings","policyname":"viewings_insert","permissive":"PERMISSIVE","roles":["authenticated"],"cmd":"INSERT","qual":null,"with_check":"(private.has_platform_admin(( SELECT auth.uid() AS uid)) OR ((requester_id = ( SELECT auth.uid() AS uid)) AND (status = 'pending'::viewing_status) AND (EXISTS ( SELECT 1\n   FROM listings listing\n  WHERE ((listing.id = viewings.listing_id) AND (listing.owner_id = viewings.owner_id))))))"}, 
