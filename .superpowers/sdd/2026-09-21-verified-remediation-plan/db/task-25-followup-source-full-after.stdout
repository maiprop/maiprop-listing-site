s_set_origin_context_key", "enabled" : "O", "definition" : "CREATE TRIGGER leads_set_origin_context_key BEFORE INSERT ON leads FOR EACH ROW EXECUTE FUNCTION private.set_lead_origin_context_key()", "function" : "private.set_lead_origin_context_key()"}, {"table" : "leads", "name" : "leads_preserve_origin_context_key", "enabled" : "O", "definition" : "CREATE TRIGGER leads_preserve_origin_context_key BEFORE UPDATE OF origin_context_key ON leads FOR EACH ROW EXECUTE FUNCTION private.set_lead_origin_context_key()", "function" : "private.set_lead_origin_context_key()"}], "routines" : [{"schema" : "auth", "signature" : "auth.role()", "name" : "role", "owner" : "postgres", "acl" : null, "security_definer" : false, "config" : null, "body" : "\n SELECT COALESCE(NULLIF(current_setting('request.jwt.claim.role',true),''),auth.jwt()->>'role','anon')\n", "definition" : "CREATE OR REPLACE FUNCTION auth.role()\n RETURNS text\n LANGUAGE sql\n STABLE\nAS $function$\n SELECT COALESCE(NULLIF(current_setting('request.jwt.claim.role',true),''),auth.jwt()->>'role','anon')\n$function$\n"}, {"schema" : "auth", "signature" : "auth.uid()", "name" : "uid", "owner" : "postgres", "acl" : null, "security_definer" : false, "config" : null, "body" : "\n SELECT COALESCE(NULLIF(current_setting('request.jwt.claim.sub',true),''),NULLIF(current_setting('request.jwt.claims',true),'')::jsonb->>'sub')::uuid\n", "definition" : "CREATE OR REPLACE FUNCTION auth.uid()\n RETURNS uuid\n LANGUAGE sql\n STABLE\nAS $function$\n SELECT COALESCE(NULLIF(current_setting('request.jwt.claim.sub',true),''),NULLIF(current_setting('request.jwt.claims',true),'')::jsonb->>'sub')::uuid\n$function$\n"}, {"schema" : "private", "signature" : "private.authoritative_role()", "name" : "authoritative_role", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres","authenticated=X/postgres"], "security_definer" : true, "config" : ["search_path=public"], "body" : "\n  select private.authoritative_role((select auth.uid()))\n", "definition" : "CREATE OR REPLACE FUNCTION private.authoritative_role()\n RETURNS user_role\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select private.authoritative_role((select auth.uid()))\n$function$\n"}, {"schema" : "private", "signature" : "private.authoritative_role(uuid)", "name" : "authoritative_role", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=public"], "body" : "\n  select role\n  from public.profiles\n  where user_id = _user_id\n  limit 1\n", "definition" : "CREATE OR REPLACE FUNCTION private.authoritative_role(_user_id uuid)\n RETURNS user_role\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select role\n  from public.profiles\n  where user_id = _user_id\n  limit 1\n$function$\n"}, {"schema" : "private", "signature" : "private.can_request_viewing_for_listing(uuid,uuid)", "name" : "can_request_viewing_for_listing", "owner" : "postgres", "acl" : ["postgres=X/postgres","authenticated=X/postgres"], "security_definer" : true, "config" : ["search_path=\"\""], "body" : "\n  SELECT COALESCE(\n    (SELECT auth.uid()) IS NOT NULL\n    AND p_listing_id IS NOT NULL\n    AND p_expected_owner_id IS NOT NULL\n    AND EXISTS (\n      SELECT 1\n      FROM public.listings AS l\n      WHERE l.id = p_listing_id\n        AND l.owner_id = p_expected_owner_id\n        AND (\n          (\n            l.status = 'active'::public.listing_status\n            AND COALESCE(l.is_off_market, false) = false\n          )\n          OR l.owner_id = (SELECT auth.uid())\n          OR (\n            l.organization_id IS NOT NULL\n            AND private.has_org_permission(\n              l.organization_id,\n              'listing:view',\n              (SELECT auth.uid())\n            )\n          )\n        )\n    ),\n    false\n  )\n", "definition" : "CREATE OR REPLACE FUNCTION private.can_request_viewing_for_listing(p_listing_id uuid, p_expected_owner_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  SELECT COALESCE(\n    (SELECT auth.uid()) IS NOT NULL\n    AND p_listing_id IS NOT NULL\n    AND p_expected_owner_id IS NOT NULL\n    AND EXISTS (\n      SELECT 1\n      FROM public.listings AS l\n      WHERE l.id = p_listing_id\n        AND l.owner_id = p_expected_owner_id\n        AND (\n          (\n            l.status = 'active'::public.listing_status\n            AND COALESCE(l.is_off_market, false) = false\n          )\n          OR l.owner_id = (SELECT auth.uid())\n          OR (\n            l.organization_id IS NOT NULL\n            AND private.has_org_permission(\n              l.organization_id,\n              'listing:view',\n              (SELECT auth.uid())\n            )\n          )\n        )\n    ),\n    false\n  )\n$function$\n"}, {"schema" : "private", "signature" : "private.capture_viewing_owner_lead()", "name" : "capture_viewing_owner_lead", "owner" : "postgres", "acl" : ["postgres=X/postgres"], "security_definer" : true, "config" : ["search_path=public, private, pg_temp"], "body" : "\nDECLARE\n  v_display_name text;\n  v_first_name text;\n  v_last_name text;\n  v_phone text;\n  v_requester_email text;\n  v_listing_title text;\n  v_name text;\nBEGIN\n  BEGIN\n    SELECT p.display_name, p.first_name, p.last_name, p.phone\n      INTO v_display_name, v_first_name, v_last_name, v_phone\n      FROM public.profiles p\n     WHERE p.user_id = NEW.requester_id\n     LIMIT 1;\n\n    SELECT u.email\n      INTO v_requester_email\n      FROM auth.users u\n     WHERE u.id = NEW.requester_id\n     LIMIT 1;\n\n    SELECT l.title\n      INTO v_listing_title\n      FROM public.listings l\n     WHERE l.id = NEW.listing_id\n     LIMIT 1;\n\n    v_name := COALESCE(\n      NULLIF(v_display_name, ''),\n      NULLIF(trim(concat_ws(' ', v_first_name, v_last_name)), ''),\n      NULLIF(v_requester_email, ''),\n      'Viewing request'\n    );\n\n    PERFORM private.upsert_owner_lead(\n      NEW.owner_id,\n      'viewing',\n      NEW.listing_id,\n      NULL,\n      NULL,\n      v_name,\n      v_requester_email,\n      v_phone,\n      concat_ws(\n        ' ',\n        'Viewing request for',\n        COALESCE(NULLIF(v_listing_title, ''), 'listing'),\n        concat('(', replace(NEW.viewing_type::text, '_', '-'), ')')\n      ),\n      'new',\n      NULL,\n      NEW.scheduled_at\n    );\n  EXCEPTION WHEN others THEN\n    RAISE WARNING 'Could not auto-create viewing lead for viewing %: %', NEW.id, SQLERRM;\n  END;\n\n  RETURN NEW;\nEND;\n", "definition" : "CREATE OR REPLACE FUNCTION private.capture_viewing_owner_lead()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'private', 'pg_temp'\nAS $function$\nDECLARE\n  v_display_name text;\n  v_first_name text;\n  v_last_name text;\n  v_phone text;\n  v_requester_email text;\n  v_listing_title text;\n  v_name text;\nBEGIN\n  BEGIN\n    SELECT p.display_name, p.first_name, p.last_name, p.phone\n      INTO v_display_name, v_first_name, v_last_name, v_phone\n      FROM public.profiles p\n     WHERE p.user_id = NEW.requester_id\n     LIMIT 1;\n\n    SELECT u.email\n      INTO v_requester_email\n      FROM auth.users u\n     WHERE u.id = NEW.requester_id\n     LIMIT 1;\n\n    SELECT l.title\n      INTO v_listing_title\n      FROM public.listings l\n     WHERE l.id = NEW.listing_id\n     LIMIT 1;\n\n    v_name := COALESCE(\n      NULLIF(v_display_name, ''),\n      NULLIF(trim(concat_ws(' ', v_first_name, v_last_name)), ''),\n      NULLIF(v_requester_email, ''),\n      'Viewing request'\n    );\n\n    PERFORM private.upsert_owner_lead(\n      NEW.owner_id,\n      'viewing',\n      NEW.listing_id,\n      NULL,\n      NULL,\n      v_name,\n      v_requester_email,\n      v_phone,\n      concat_ws(\n        ' ',\n        'Viewing request for',\n        COALESCE(NULLIF(v_listing_title, ''), 'listing'),\n        concat('(', replace(NEW.viewing_type::text, '_', '-'), ')')\n      ),\n      'new',\n      NULL,\n      NEW.scheduled_at\n    );\n  EXCEPTION WHEN others THEN\n    RAISE WARNING 'Could not auto-create viewing lead for viewing %: %', NEW.id, SQLERRM;\n  END;\n\n  RETURN NEW;\nEND;\n$function$\n"}, {"schema" : "private", "signature" : "private.current_billing_subscription_for_user(uuid,text)", "name" : "current_billing_subscription_for_user", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=pg_catalog, public"], "body" : "\n  SELECT subscription.*\n  FROM public.billing_subscriptions AS subscription\n  JOIN public.profiles AS profile\n    ON profile.user_id = subscription.user_id\n  JOIN public.pricing_configs AS pricing\n    ON pricing.is_active = true\n   AND pricing.audience = public.profile_pricing_audience(\n     profile.role,\n     profile.participant_type::text\n   )\n   AND pricing.key = subscription.plan_key\n   AND pricing.module IN (\n     'user_subscription',\n     'agent_subscription',\n     'developer_subscription',\n     'professional_subscription'\n   )\n   AND pricing.metadata->>'stripe_product_id' = subscription.stripe_product_id\n  WHERE subscription.user_id = p_user_id\n    AND profile.role_switch_in_progress_at IS NULL\n    AND subscription.runtime_mode = public.current_billing_runtime_mode()\n    AND subscription.livemode = (public.current_billing_runtime_mode() = 'live')\n    AND subscription.audience = public.profile_pricing_audience(\n      profile.role,\n      profile.participant_type::text\n    )\n    AND subscription.status IN ('active', 'trialing', 'past_due')\n    AND (\n      p_required_stripe_subscription_id IS NULL\n      OR subscription.stripe_subscription_id = p_required_stripe_subscription_id\n    )\n    AND CASE\n      WHEN subscription.status = 'trialing' THEN\n        COALESCE(subscription.trial_end, subscription.current_period_end) IS NOT NULL\n        AND COALESCE(subscription.trial_end, subscription.current_period_end) > now()\n      ELSE\n        subscription.current_period_end IS NOT NULL\n        AND subscription.current_period_end > now()\n    END\n  ORDER BY subscription.updated_at DESC, subscription.id DESC\n  LIMIT 1\n", "definition" : "CREATE OR REPLACE FUNCTION private.current_billing_subscription_for_user(p_user_id uuid, p_required_stripe_subscription_id text DEFAULT NULL::text)\n RETURNS SETOF billing_subscriptions\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'public'\nAS $function$\n  SELECT subscription.*\n  FROM public.billing_subscriptions AS subscription\n  JOIN public.profiles AS profile\n    ON profile.user_id = subscription.user_id\n  JOIN public.pricing_configs AS pricing\n    ON pricing.is_active = true\n   AND pricing.audience = public.profile_pricing_audience(\n     profile.role,\n     profile.participant_type::text\n   )\n   AND pricing.key = subscription.plan_key\n   AND pricing.module IN (\n     'user_subscription',\n     'agent_subscription',\n     'developer_subscription',\n     'professional_subscription'\n   )\n   AND pricing.metadata->>'stripe_product_id' = subscription.stripe_product_id\n  WHERE subscription.user_id = p_user_id\n    AND profile.role_switch_in_progress_at IS NULL\n    AND subscription.runtime_mode = public.current_billing_runtime_mode()\n    AND subscription.livemode = (public.current_billing_runtime_mode() = 'live')\n    AND subscription.audience = public.profile_pricing_audience(\n      profile.role,\n      profile.participant_type::text\n    )\n    AND subscription.status IN ('active', 'trialing', 'past_due')\n    AND (\n      p_required_stripe_subscription_id IS NULL\n      OR subscription.stripe_subscription_id = p_required_stripe_subscription_id\n    )\n    AND CASE\n      WHEN subscription.status = 'trialing' THEN\n        COALESCE(subscription.trial_end, subscription.current_period_end) IS NOT NULL\n        AND COALESCE(subscription.trial_end, subscription.current_period_end) > now()\n      ELSE\n        subscription.current_period_end IS NOT NULL\n        AND subscription.current_period_end > now()\n    END\n  ORDER BY subscription.updated_at DESC, subscription.id DESC\n  LIMIT 1\n$function$\n"}, {"schema" : "private", "signature" : "private.has_current_billing_subscription_for_user(uuid)", "name" : "has_current_billing_subscription_for_user", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=pg_catalog, public, private"], "body" : "\n  SELECT EXISTS (\n    SELECT 1\n    FROM private.current_billing_subscription_for_user(p_user_id, NULL)\n  )\n", "definition" : "CREATE OR REPLACE FUNCTION private.has_current_billing_subscription_for_user(p_user_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'public', 'private'\nAS $function$\n  SELECT EXISTS (\n    SELECT 1\n    FROM private.current_billing_subscription_for_user(p_user_id, NULL)\n  )\n$function$\n"}, {"schema" : "private", "signature" : "private.has_investor_subscription_for_user(uuid)", "name" : "has_investor_subscription_for_user", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=pg_catalog, public"], "body" : "\n  SELECT EXISTS (\n    SELECT 1\n    FROM public.investor_subscriptions AS subscription\n    JOIN public.profiles AS profile\n      ON profile.user_id = subscription.user_id\n    WHERE subscription.user_id = p_user_id\n      AND profile.role_switch_in_progress_at IS NULL\n      AND public.profile_pricing_audience(\n        profile.role,\n        profile.participant_type::text\n      ) IN ('investor', 'institutional')\n      AND subscription.runtime_mode = public.current_billing_runtime_mode()\n      AND subscription.livemode = (\n        public.current_billing_runtime_mode() = 'live'\n      )\n      AND subscription.status IN ('active', 'trial')\n      AND (\n        subscription.expires_at IS NULL\n        OR subscription.expires_at > now()\n      )\n  )\n", "definition" : "CREATE OR REPLACE FUNCTION private.has_investor_subscription_for_user(p_user_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'public'\nAS $function$\n  SELECT EXISTS (\n    SELECT 1\n    FROM public.investor_subscriptions AS subscription\n    JOIN public.profiles AS profile\n      ON profile.user_id = subscription.user_id\n    WHERE subscription.user_id = p_user_id\n      AND profile.role_switch_in_progress_at IS NULL\n      AND public.profile_pricing_audience(\n        profile.role,\n        profile.participant_type::text\n      ) IN ('investor', 'institutional')\n      AND subscription.runtime_mode = public.current_billing_runtime_mode()\n      AND subscription.livemode = (\n        public.current_billing_runtime_mode() = 'live'\n      )\n      AND subscription.status IN ('active', 'trial')\n      AND (\n        subscription.expires_at IS NULL\n        OR subscription.expires_at > now()\n      )\n  )\n$function$\n"}, {"schema" : "private", "signature" : "private.has_org_permission(uuid,text,uuid)", "name" : "has_org_permission", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres","authenticated=X/postgres"], "security_definer" : true, "config" : ["search_path=public, pg_temp"], "body" : "\n  WITH active_membership AS (\n    SELECT memberships.role\n    FROM public.organization_memberships memberships\n    WHERE memberships.organization_id = p_org_id\n      AND memberships.user_id = p_user_id\n      AND memberships.status = 'active'\n    LIMIT 1\n  )\n  SELECT COALESCE(\n    CASE\n      WHEN p_org_id IS NULL OR p_permission IS NULL OR p_user_id IS NULL THEN false\n      WHEN private.has_platform_admin(p_user_id) THEN true\n      WHEN p_permission = ANY(ARRAY['organization:view', 'membership:view']) THEN\n        EXISTS (SELECT 1 FROM active_membership)\n      WHEN p_permission = ANY(ARRAY['listing:view', 'project:view']) THEN\n        EXISTS (SELECT 1 FROM active_membership)\n      WHEN p_permission = 'organization:update' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'billing_admin', 'security_admin'])\n        )\n      WHEN p_permission = 'membership:manage' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin'])\n        )\n      WHEN p_permission = 'membership:manage_owner' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = 'owner'\n        )\n      WHEN p_permission = 'domain:manage' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'security_admin'])\n        )\n      WHEN p_permission = 'sso:manage' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'security_admin'])\n        )\n      WHEN p_permission = ANY(ARRAY['listing:manage', 'project:manage']) THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'member'])\n        )\n      WHEN p_permission = ANY(ARRAY['procurement:view', 'procurement:manage']) THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'billing_admin', 'security_admin'])\n        )\n      WHEN p_permission = 'audit:read' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'security_admin'])\n        )\n      WHEN p_permission = 'audit:append' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'security_admin'])\n        )\n      ELSE false\n    END,\n    false\n  )\n", "definition" : "CREATE OR REPLACE FUNCTION private.has_org_permission(p_org_id uuid, p_permission text, p_user_id uuid DEFAULT auth.uid())\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\n  WITH active_membership AS (\n    SELECT memberships.role\n    FROM public.organization_memberships memberships\n    WHERE memberships.organization_id = p_org_id\n      AND memberships.user_id = p_user_id\n      AND memberships.status = 'active'\n    LIMIT 1\n  )\n  SELECT COALESCE(\n    CASE\n      WHEN p_org_id IS NULL OR p_permission IS NULL OR p_user_id IS NULL THEN false\n      WHEN private.has_platform_admin(p_user_id) THEN true\n      WHEN p_permission = ANY(ARRAY['organization:view', 'membership:view']) THEN\n        EXISTS (SELECT 1 FROM active_membership)\n      WHEN p_permission = ANY(ARRAY['listing:view', 'project:view']) THEN\n        EXISTS (SELECT 1 FROM active_membership)\n      WHEN p_permission = 'organization:update' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'billing_admin', 'security_admin'])\n        )\n      WHEN p_permission = 'membership:manage' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin'])\n        )\n      WHEN p_permission = 'membership:manage_owner' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = 'owner'\n        )\n      WHEN p_permission = 'domain:manage' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'security_admin'])\n        )\n      WHEN p_permission = 'sso:manage' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'security_admin'])\n        )\n      WHEN p_permission = ANY(ARRAY['listing:manage', 'project:manage']) THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'member'])\n        )\n      WHEN p_permission = ANY(ARRAY['procurement:view', 'procurement:manage']) THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'billing_admin', 'security_admin'])\n        )\n      WHEN p_permission = 'audit:read' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'security_admin'])\n        )\n      WHEN p_permission = 'audit:append' THEN\n        EXISTS (\n          SELECT 1\n          FROM active_membership\n          WHERE role = ANY(ARRAY['owner', 'admin', 'security_admin'])\n        )\n      ELSE false\n    END,\n    false\n  )\n$function$\n"}, {"schema" : "private", "signature" : "private.has_platform_admin(uuid)", "name" : "has_platform_admin", "owner" : "postgres", "acl" : ["postgres=X/postgres","authenticated=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=public"], "body" : "\n  select private.authoritative_role(_user_id) = 'admin'::public.user_role\n", "definition" : "CREATE OR REPLACE FUNCTION private.has_platform_admin(_user_id uuid DEFAULT auth.uid())\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  select private.authoritative_role(_user_id) = 'admin'::public.user_role\n$function$\n"}, {"schema" : "private", "signature" : "private.insert_interaction_notification(uuid,uuid,text,text,text,text)", "name" : "insert_interaction_notification", "owner" : "postgres", "acl" : ["postgres=X/postgres"], "security_definer" : true, "config" : ["search_path=public, pg_temp"], "body" : "\nBEGIN\n  IF p_user_id IS NULL OR p_user_id = p_actor_id THEN\n    RETURN;\n  END IF;\n\n  BEGIN\n    INSERT INTO public.notifications (user_id, title, body, type, link)\n    VALUES (p_user_id, p_title, p_body, p_type, p_link);\n  EXCEPTION WHEN undefined_column THEN\n    -- Older environments may not have the later notifications.link column yet.\n    INSERT INTO public.notifications (user_id, title, body, type)\n    VALUES (p_user_id, p_title, p_body, p_type);\n  END;\nEXCEPTION WHEN others THEN\n  RAISE WARNING 'Could not create interaction notification for user %: %', p_user_id, SQLERRM;\nEND;\n", "definition" : "CREATE OR REPLACE FUNCTION private.insert_interaction_notification(p_user_id uuid, p_actor_id uuid, p_title text, p_body text, p_type text, p_link text DEFAULT NULL::text)\n RETURNS void\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nBEGIN\n  IF p_user_id IS NULL OR p_user_id = p_actor_id THEN\n    RETURN;\n  END IF;\n\n  BEGIN\n    INSERT INTO public.notifications (user_id, title, body, type, link)\n    VALUES (p_user_id, p_title, p_body, p_type, p_link);\n  EXCEPTION WHEN undefined_column THEN\n    -- Older environments may not have the later notifications.link column yet.\n    INSERT INTO public.notifications (user_id, title, body, type)\n    VALUES (p_user_id, p_title, p_body, p_type);\n  END;\nEXCEPTION WHEN others THEN\n  RAISE WARNING 'Could not create interaction notification for user %: %', p_user_id, SQLERRM;\nEND;\n$function$\n"}, {"schema" : "private", "signature" : "private.notify_viewing_created()", "name" : "notify_viewing_created", "owner" : "postgres", "acl" : ["postgres=X/postgres"], "security_definer" : true, "config" : ["search_path=public, pg_temp"], "body" : "\nDECLARE\n  v_listing_title text;\nBEGIN\n  SELECT title INTO v_listing_title\n  FROM public.listings\n  WHERE id = NEW.listing_id\n  LIMIT 1;\n\n  PERFORM private.insert_interaction_notification(\n    NEW.owner_id,\n    NEW.requester_id,\n    'New viewing request',\n    concat_ws(' ', 'A buyer requested a', replace(NEW.viewing_type::text, '_', '-'), 'viewing for', COALESCE(NULLIF(v_listing_title, ''), 'your listing')),\n    'viewing',\n    '/dashboard?tab=viewings'\n  );\n\n  RETURN NEW;\nEND;\n", "definition" : "CREATE OR REPLACE FUNCTION private.notify_viewing_created()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nDECLARE\n  v_listing_title text;\nBEGIN\n  SELECT title INTO v_listing_title\n  FROM public.listings\n  WHERE id = NEW.listing_id\n  LIMIT 1;\n\n  PERFORM private.insert_interaction_notification(\n    NEW.owner_id,\n    NEW.requester_id,\n    'New viewing request',\n    concat_ws(' ', 'A buyer requested a', replace(NEW.viewing_type::text, '_', '-'), 'viewing for', COALESCE(NULLIF(v_listing_title, ''), 'your listing')),\n    'viewing',\n    '/dashboard?tab=viewings'\n  );\n\n  RETURN NEW;\nEND;\n$function$\n"}, {"schema" : "private", "signature" : "private.notify_viewing_status_changed()", "name" : "notify_viewing_status_changed", "owner" : "postgres", "acl" : ["postgres=X/postgres"], "security_definer" : true, "config" : ["search_path=public, pg_temp"], "body" : "\nDECLARE\n  v_listing_title text;\n  v_actor_id uuid := auth.uid();\n  v_recipient_id uuid;\nBEGIN\n  IF NEW.status IS NOT DISTINCT FROM OLD.status THEN\n    RETURN NEW;\n  END IF;\n\n  v_recipient_id := CASE\n    WHEN v_actor_id = NEW.requester_id THEN NEW.owner_id\n    ELSE NEW.requester_id\n  END;\n\n  SELECT title INTO v_listing_title\n  FROM public.listings\n  WHERE id = NEW.listing_id\n  LIMIT 1;\n\n  PERFORM private.insert_interaction_notification(\n    v_recipient_id,\n    v_actor_id,\n    'Viewing status updated',\n    concat_ws(' ', 'Your viewing for', COALESCE(NULLIF(v_listing_title, ''), 'a listing'), 'is now', NEW.status::text),\n    'viewing',\n    '/dashboard?tab=viewings'\n  );\n\n  RETURN NEW;\nEND;\n", "definition" : "CREATE OR REPLACE FUNCTION private.notify_viewing_status_changed()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nDECLARE\n  v_listing_title text;\n  v_actor_id uuid := auth.uid();\n  v_recipient_id uuid;\nBEGIN\n  IF NEW.status IS NOT DISTINCT FROM OLD.status THEN\n    RETURN NEW;\n  END IF;\n\n  v_recipient_id := CASE\n    WHEN v_actor_id = NEW.requester_id THEN NEW.owner_id\n    ELSE NEW.requester_id\n  END;\n\n  SELECT title INTO v_listing_title\n  FROM public.listings\n  WHERE id = NEW.listing_id\n  LIMIT 1;\n\n  PERFORM private.insert_interaction_notification(\n    v_recipient_id,\n    v_actor_id,\n    'Viewing status updated',\n    concat_ws(' ', 'Your viewing for', COALESCE(NULLIF(v_listing_title, ''), 'a listing'), 'is now', NEW.status::text),\n    'viewing',\n    '/dashboard?tab=viewings'\n  );\n\n  RETURN NEW;\nEND;\n$function$\n"}, {"schema" : "private", "signature" : "private.set_lead_origin_context_key()", "name" : "set_lead_origin_context_key", "owner" : "postgres", "acl" : ["postgres=X/postgres"], "security_definer" : true, "config" : ["search_path=public, private, pg_temp"], "body" : "\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    NEW.origin_context_key := COALESCE(\n      'listing:' || NEW.listing_id::text,\n      'professional:' || NEW.professional_id::text,\n      'project:' || NEW.project_id::text,\n      'general'\n    );\n  ELSE\n    NEW.origin_context_key := OLD.origin_context_key;\n  END IF;\n\n  RETURN NEW;\nEND;\n", "definition" : "CREATE OR REPLACE FUNCTION private.set_lead_origin_context_key()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'private', 'pg_temp'\nAS $function$\nBEGIN\n  IF TG_OP = 'INSERT' THEN\n    NEW.origin_context_key := COALESCE(\n      'listing:' || NEW.listing_id::text,\n      'professional:' || NEW.professional_id::text,\n      'project:' || NEW.project_id::text,\n      'general'\n    );\n  ELSE\n    NEW.origin_context_key := OLD.origin_context_key;\n  END IF;\n\n  RETURN NEW;\nEND;\n$function$\n"}, {"schema" : "private", "signature" : "private.upsert_owner_lead(uuid,text,uuid,uuid,uuid,text,text,text,text,text,text,timestamp with time zone)", "name" : "upsert_owner_lead", "owner" : "postgres", "acl" : ["postgres=X/postgres"], "security_definer" : true, "config" : ["search_path=public, private, pg_temp"], "body" : "\nDECLARE\n  v_source text;\n  v_status text;\n  v_name text;\n  v_email text;\n  v_phone text;\n  v_phone_key text;\n  v_context_key text;\n  v_lead_id uuid;\nBEGIN\n  IF p_owner_id IS NULL THEN\n    RETURN NULL;\n  END IF;\n\n  v_source := CASE\n    WHEN p_source IN (\n      'manual', 'listing_inquiry', 'consultation', 'callback',\n      'project_inquiry', 'viewing', 'message'\n    ) THEN p_source\n    ELSE 'manual'\n  END;\n\n  v_status := CASE\n    WHEN p_status IN (\n      'new', 'contacted', 'qualified', 'proposal',\n      'negotiation', 'won', 'lost'\n    ) THEN p_status\n    ELSE 'new'\n  END;\n\n  v_name := COALESCE(\n    NULLIF(btrim(p_name), ''),\n    NULLIF(btrim(p_email), ''),\n    NULLIF(btrim(p_phone), ''),\n    'Inbound lead'\n  );\n  v_email := lower(NULLIF(btrim(p_email), ''));\n  v_phone := NULLIF(btrim(p_phone), '');\n  v_phone_key := NULLIF(\n    regexp_replace(COALESCE(v_phone, ''), '\\D', '', 'g'),\n    ''\n  );\n  v_context_key := COALESCE(\n    'listing:' || p_listing_id::text,\n    'professional:' || p_professional_id::text,\n    'project:' || p_project_id::text,\n    'general'\n  );\n\n  IF v_source <> 'manual' AND (v_email IS NOT NULL OR v_phone_key IS NOT NULL) THEN\n    WITH matched AS (\n      SELECT lead.id\n      FROM public.leads AS lead\n      WHERE lead.owner_id = p_owner_id\n        AND lead.source <> 'manual'\n        AND lead.origin_context_key = v_context_key\n        AND (\n          (\n            v_email IS NOT NULL\n            AND lower(btrim(COALESCE(lead.email, ''))) = v_email\n          )\n          OR (\n            v_phone_key IS NOT NULL\n            AND regexp_replace(COALESCE(lead.phone, ''), '\\D', '', 'g') = v_phone_key\n          )\n        )\n      ORDER BY lead.created_at, lead.id\n      LIMIT 1\n    )\n    UPDATE public.leads AS existing\n    SET source = CASE\n          WHEN v_source = 'project_inquiry' THEN 'project_inquiry'\n          ELSE existing.source\n        END,\n        listing_id = COALESCE(existing.listing_id, p_listing_id),\n        professional_id = COALESCE(existing.professional_id, p_professional_id),\n        project_id = COALESCE(existing.project_id, p_project_id),\n        name = CASE\n          WHEN existing.name IN (\n            'Inbound lead', 'Message inquiry', 'Viewing request',\n            'Consultation request', 'New-build inquiry'\n          ) THEN v_name\n          ELSE existing.name\n        END,\n        email = COALESCE(NULLIF(existing.email, ''), v_email),\n        phone = COALESCE(NULLIF(existing.phone, ''), v_phone),\n        message = COALESCE(existing.message, NULLIF(btrim(p_message), '')),\n        notes = CASE\n          WHEN NULLIF(btrim(p_notes), '') IS NULL THEN existing.notes\n          WHEN NULLIF(btrim(COALESCE(existing.notes, '')), '') IS NULL THEN btrim(p_notes)\n          WHEN position(btrim(p_notes) in existing.notes) > 0 THEN existing.notes\n          ELSE concat_ws(E'\\n\\n', existing.notes, btrim(p_notes))\n        END,\n        follow_up_at = COALESCE(existing.follow_up_at, p_follow_up_at),\n        updated_at = now()\n    FROM matched\n    WHERE existing.id = matched.id\n    RETURNING existing.id INTO v_lead_id;\n  END IF;\n\n  IF v_lead_id IS NOT NULL THEN\n    RETURN v_lead_id;\n  END IF;\n\n  BEGIN\n    INSERT INTO public.leads (\n      owner_id,\n      source,\n      listing_id,\n      professional_id,\n      project_id,\n      name,\n      email,\n      phone,\n      message,\n      status,\n      notes,\n      follow_up_at\n    )\n    VALUES (\n      p_owner_id,\n      v_source,\n      p_listing_id,\n      p_professional_id,\n      p_project_id,\n      v_name,\n      v_email,\n      v_phone,\n      NULLIF(btrim(p_message), ''),\n      v_status,\n      NULLIF(btrim(p_notes), ''),\n      p_follow_up_at\n    )\n    RETURNING id INTO v_lead_id;\n  EXCEPTION WHEN unique_violation THEN\n    WITH matched AS (\n      SELECT lead.id\n      FROM public.leads AS lead\n      WHERE lead.owner_id = p_owner_id\n        AND lead.source <> 'manual'\n        AND lead.origin_context_key = v_context_key\n        AND (\n          (\n            v_email IS NOT NULL\n            AND lower(btrim(COALESCE(lead.email, ''))) = v_email\n          )\n          OR (\n            v_phone_key IS NOT NULL\n            AND regexp_replace(COALESCE(lead.phone, ''), '\\D', '', 'g') = v_phone_key\n          )\n        )\n      ORDER BY lead.created_at, lead.id\n      LIMIT 1\n    )\n    UPDATE public.leads AS existing\n    SET source = CASE\n          WHEN v_source = 'project_inquiry' THEN 'project_inquiry'\n          ELSE existing.source\n        END,\n        listing_id = COALESCE(existing.listing_id, p_listing_id),\n        professional_id = COALESCE(existing.professional_id, p_professional_id),\n        project_id = COALESCE(existing.project_id, p_project_id),\n        email = COALESCE(NULLIF(existing.email, ''), v_email),\n        phone = COALESCE(NULLIF(existing.phone, ''), v_phone),\n        updated_at = now()\n    FROM matched\n    WHERE existing.id = matched.id\n    RETURNING existing.id INTO v_lead_id;\n  END;\n\n  RETURN v_lead_id;\nEND;\n", "definition" : "CREATE OR REPLACE FUNCTION private.upsert_owner_lead(p_owner_id uuid, p_source text, p_listing_id uuid DEFAULT NULL::uuid, p_professional_id uuid DEFAULT NULL::uuid, p_project_id uuid DEFAULT NULL::uuid, p_name text DEFAULT NULL::text, p_email text DEFAULT NULL::text, p_phone text DEFAULT NULL::text, p_message text DEFAULT NULL::text, p_status text DEFAULT 'new'::text, p_notes text DEFAULT NULL::text, p_follow_up_at timestamp with time zone DEFAULT NULL::timestamp with time zone)\n RETURNS uuid\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'private', 'pg_temp'\nAS $function$\nDECLARE\n  v_source text;\n  v_status text;\n  v_name text;\n  v_email text;\n  v_phone text;\n  v_phone_key text;\n  v_context_key text;\n  v_lead_id uuid;\nBEGIN\n  IF p_owner_id IS NULL THEN\n    RETURN NULL;\n  END IF;\n\n  v_source := CASE\n    WHEN p_source IN (\n      'manual', 'listing_inquiry', 'consultation', 'callback',\n      'project_inquiry', 'viewing', 'message'\n    ) THEN p_source\n    ELSE 'manual'\n  END;\n\n  v_status := CASE\n    WHEN p_status IN (\n      'new', 'contacted', 'qualified', 'proposal',\n      'negotiation', 'won', 'lost'\n    ) THEN p_status\n    ELSE 'new'\n  END;\n\n  v_name := COALESCE(\n    NULLIF(btrim(p_name), ''),\n    NULLIF(btrim(p_email), ''),\n    NULLIF(btrim(p_phone), ''),\n    'Inbound lead'\n  );\n  v_email := lower(NULLIF(btrim(p_email), ''));\n  v_phone := NULLIF(btrim(p_phone), '');\n  v_phone_key := NULLIF(\n    regexp_replace(COALESCE(v_phone, ''), '\\D', '', 'g'),\n    ''\n  );\n  v_context_key := COALESCE(\n    'listing:' || p_listing_id::text,\n    'professional:' || p_professional_id::text,\n    'project:' || p_project_id::text,\n    'general'\n  );\n\n  IF v_source <> 'manual' AND (v_email IS NOT NULL OR v_phone_key IS NOT NULL) THEN\n    WITH matched AS (\n      SELECT lead.id\n      FROM public.leads AS lead\n      WHERE lead.owner_id = p_owner_id\n        AND lead.source <> 'manual'\n        AND lead.origin_context_key = v_context_key\n        AND (\n          (\n            v_email IS NOT NULL\n            AND lower(btrim(COALESCE(lead.email, ''))) = v_email\n          )\n          OR (\n            v_phone_key IS NOT NULL\n            AND regexp_replace(COALESCE(lead.phone, ''), '\\D', '', 'g') = v_phone_key\n          )\n        )\n      ORDER BY lead.created_at, lead.id\n      LIMIT 1\n    )\n    UPDATE public.leads AS existing\n    SET source = CASE\n          WHEN v_source = 'project_inquiry' THEN 'project_inquiry'\n          ELSE existing.source\n        END,\n        listing_id = COALESCE(existing.listing_id, p_listing_id),\n        professional_id = COALESCE(existing.professional_id, p_professional_id),\n        project_id = COALESCE(existing.project_id, p_project_id),\n        name = CASE\n          WHEN existing.name IN (\n            'Inbound lead', 'Message inquiry', 'Viewing request',\n            'Consultation request', 'New-build inquiry'\n          ) THEN v_name\n          ELSE existing.name\n        END,\n        email = COALESCE(NULLIF(existing.email, ''), v_email),\n        phone = COALESCE(NULLIF(existing.phone, ''), v_phone),\n        message = COALESCE(existing.message, NULLIF(btrim(p_message), '')),\n        notes = CASE\n          WHEN NULLIF(btrim(p_notes), '') IS NULL THEN existing.notes\n          WHEN NULLIF(btrim(COALESCE(existing.notes, '')), '') IS NULL THEN btrim(p_notes)\n          WHEN position(btrim(p_notes) in existing.notes) > 0 THEN existing.notes\n          ELSE concat_ws(E'\\n\\n', existing.notes, btrim(p_notes))\n        END,\n        follow_up_at = COALESCE(existing.follow_up_at, p_follow_up_at),\n        updated_at = now()\n    FROM matched\n    WHERE existing.id = matched.id\n    RETURNING existing.id INTO v_lead_id;\n  END IF;\n\n  IF v_lead_id IS NOT NULL THEN\n    RETURN v_lead_id;\n  END IF;\n\n  BEGIN\n    INSERT INTO public.leads (\n      owner_id,\n      source,\n      listing_id,\n      professional_id,\n      project_id,\n      name,\n      email,\n      phone,\n      message,\n      status,\n      notes,\n      follow_up_at\n    )\n    VALUES (\n      p_owner_id,\n      v_source,\n      p_listing_id,\n      p_professional_id,\n      p_project_id,\n      v_name,\n      v_email,\n      v_phone,\n      NULLIF(btrim(p_message), ''),\n      v_status,\n      NULLIF(btrim(p_notes), ''),\n      p_follow_up_at\n    )\n    RETURNING id INTO v_lead_id;\n  EXCEPTION WHEN unique_violation THEN\n    WITH matched AS (\n      SELECT lead.id\n      FROM public.leads AS lead\n      WHERE lead.owner_id = p_owner_id\n        AND lead.source <> 'manual'\n        AND lead.origin_context_key = v_context_key\n        AND (\n          (\n            v_email IS NOT NULL\n            AND lower(btrim(COALESCE(lead.email, ''))) = v_email\n          )\n          OR (\n            v_phone_key IS NOT NULL\n            AND regexp_replace(COALESCE(lead.phone, ''), '\\D', '', 'g') = v_phone_key\n          )\n        )\n      ORDER BY lead.created_at, lead.id\n      LIMIT 1\n    )\n    UPDATE public.leads AS existing\n    SET source = CASE\n          WHEN v_source = 'project_inquiry' THEN 'project_inquiry'\n          ELSE existing.source\n        END,\n        listing_id = COALESCE(existing.listing_id, p_listing_id),\n        professional_id = COALESCE(existing.professional_id, p_professional_id),\n        project_id = COALESCE(existing.project_id, p_project_id),\n        email = COALESCE(NULLIF(existing.email, ''), v_email),\n        phone = COALESCE(NULLIF(existing.phone, ''), v_phone),\n        updated_at = now()\n    FROM matched\n    WHERE existing.id = matched.id\n    RETURNING existing.id INTO v_lead_id;\n  END;\n\n  RETURN v_lead_id;\nEND;\n$function$\n"}, {"schema" : "public", "signature" : "authoritative_role()", "name" : "authoritative_role", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=public"], "body" : "\n  SELECT public.authoritative_role(auth.uid())\n", "definition" : "CREATE OR REPLACE FUNCTION public.authoritative_role()\n RETURNS user_role\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT public.authoritative_role(auth.uid())\n$function$\n"}, {"schema" : "public", "signature" : "authoritative_role(uuid)", "name" : "authoritative_role", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=public"], "body" : "\n  WITH caller AS (\n    SELECT\n      auth.uid() AS uid,\n      COALESCE(auth.role(), '') AS jwt_role\n  )\n  SELECT target.role\n  FROM public.profiles AS target\n  CROSS JOIN caller\n  WHERE target.user_id = _user_id\n    AND (\n      _user_id = caller.uid\n      OR caller.jwt_role = 'service_role'\n      OR EXISTS (\n        SELECT 1\n        FROM public.profiles AS admin_profile\n        WHERE admin_profile.user_id = caller.uid\n          AND admin_profile.role = 'admin'::public.user_role\n      )\n    )\n  LIMIT 1\n", "definition" : "CREATE OR REPLACE FUNCTION public.authoritative_role(_user_id uuid)\n RETURNS user_role\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  WITH caller AS (\n    SELECT\n      auth.uid() AS uid,\n      COALESCE(auth.role(), '') AS jwt_role\n  )\n  SELECT target.role\n  FROM public.profiles AS target\n  CROSS JOIN caller\n  WHERE target.user_id = _user_id\n    AND (\n      _user_id = caller.uid\n      OR caller.jwt_role = 'service_role'\n      OR EXISTS (\n        SELECT 1\n        FROM public.profiles AS admin_profile\n        WHERE admin_profile.user_id = caller.uid\n          AND admin_profile.role = 'admin'::public.user_role\n      )\n    )\n  LIMIT 1\n$function$\n"}, {"schema" : "public", "signature" : "check_viewing_limit()", "name" : "check_viewing_limit", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=public"], "body" : "\nDECLARE\n  v_limit_requester INT;\n  v_limit_owner INT;\n  v_count_requester INT;\n  v_count_owner INT;\n  v_month_start TIMESTAMPTZ;\nBEGIN\n  -- Service role (auth.uid() IS NULL) bypasses limit checks (used by seed scripts / admin tools)\n  IF auth.uid() IS NULL THEN\n    RETURN NEW;\n  END IF;\n\n  v_month_start := date_trunc('month', now())::timestamptz;\n\n  -- Check requester (buyer) limit\n  v_limit_requester := public.get_viewing_limit(NEW.requester_id, true);\n  IF v_limit_requester < 999 THEN\n    SELECT COUNT(*) INTO v_count_requester FROM public.viewings\n    WHERE requester_id = NEW.requester_id AND created_at >= v_month_start;\n    IF v_count_requester >= v_limit_requester THEN\n      RAISE EXCEPTION 'viewing_limit_reached' USING HINT = 'Upgrade to Pro for more viewings per month';\n    END IF;\n  END IF;\n\n  -- Check owner (agent) limit - viewings on their listings\n  v_limit_owner := public.get_viewing_limit(NEW.owner_id, false);\n  IF v_limit_owner < 999 THEN\n    SELECT COUNT(*) INTO v_count_owner FROM public.viewings\n    WHERE owner_id = NEW.owner_id AND created_at >= v_month_start;\n    IF v_count_owner >= v_limit_owner THEN\n      RAISE EXCEPTION 'viewing_limit_reached' USING HINT = 'Listing owner has reached viewing limit. Upgrade to Pro for more.';\n    END IF;\n  END IF;\n\n  RETURN NEW;\nEND;\n", "definition" : "CREATE OR REPLACE FUNCTION public.check_viewing_limit()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\nDECLARE\n  v_limit_requester INT;\n  v_limit_owner INT;\n  v_count_requester INT;\n  v_count_owner INT;\n  v_month_start TIMESTAMPTZ;\nBEGIN\n  -- Service role (auth.uid() IS NULL) bypasses limit checks (used by seed scripts / admin tools)\n  IF auth.uid() IS NULL THEN\n    RETURN NEW;\n  END IF;\n\n  v_month_start := date_trunc('month', now())::timestamptz;\n\n  -- Check requester (buyer) limit\n  v_limit_requester := public.get_viewing_limit(NEW.requester_id, true);\n  IF v_limit_requester < 999 THEN\n    SELECT COUNT(*) INTO v_count_requester FROM public.viewings\n    WHERE requester_id = NEW.requester_id AND created_at >= v_month_start;\n    IF v_count_requester >= v_limit_requester THEN\n      RAISE EXCEPTION 'viewing_limit_reached' USING HINT = 'Upgrade to Pro for more viewings per month';\n    END IF;\n  END IF;\n\n  -- Check owner (agent) limit - viewings on their listings\n  v_limit_owner := public.get_viewing_limit(NEW.owner_id, false);\n  IF v_limit_owner < 999 THEN\n    SELECT COUNT(*) INTO v_count_owner FROM public.viewings\n    WHERE owner_id = NEW.owner_id AND created_at >= v_month_start;\n    IF v_count_owner >= v_limit_owner THEN\n      RAISE EXCEPTION 'viewing_limit_reached' USING HINT = 'Listing owner has reached viewing limit. Upgrade to Pro for more.';\n    END IF;\n  END IF;\n\n  RETURN NEW;\nEND;\n$function$\n"}, {"schema" : "public", "signature" : "current_billing_runtime_mode()", "name" : "current_billing_runtime_mode", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=pg_catalog, public, private"], "body" : "\nDECLARE\n  v_runtime_mode text;\nBEGIN\n  SELECT runtime_mode\n  INTO v_runtime_mode\n  FROM private.billing_runtime_config\n  WHERE singleton;\n\n  IF v_runtime_mode IS NULL THEN\n    RAISE EXCEPTION 'billing_runtime_mode_not_configured'\n      USING ERRCODE = '55000';\n  END IF;\n  RETURN v_runtime_mode;\nEND;\n", "definition" : "CREATE OR REPLACE FUNCTION public.current_billing_runtime_mode()\n RETURNS text\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'public', 'private'\nAS $function$\nDECLARE\n  v_runtime_mode text;\nBEGIN\n  SELECT runtime_mode\n  INTO v_runtime_mode\n  FROM private.billing_runtime_config\n  WHERE singleton;\n\n  IF v_runtime_mode IS NULL THEN\n    RAISE EXCEPTION 'billing_runtime_mode_not_configured'\n      USING ERRCODE = '55000';\n  END IF;\n  RETURN v_runtime_mode;\nEND;\n$function$\n"}, {"schema" : "public", "signature" : "get_listing_reference_catalogue()", "name" : "get_listing_reference_catalogue", "owner" : "postgres", "acl" : ["postgres=X/postgres","anon=X/postgres","authenticated=X/postgres"], "security_definer" : true, "config" : ["search_path=\"\""], "body" : "\n  SELECT catalogue.*\n  FROM public.listing_reference_catalogue AS catalogue;\n", "definition" : "CREATE OR REPLACE FUNCTION public.get_listing_reference_catalogue()\n RETURNS SETOF listing_reference_catalogue\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  SELECT catalogue.*\n  FROM public.listing_reference_catalogue AS catalogue;\n$function$\n"}, {"schema" : "public", "signature" : "get_viewing_limit(uuid,boolean)", "name" : "get_viewing_limit", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=\"\""], "body" : "\nDECLARE\n  v_role public.user_role;\nBEGIN\n  v_role := private.authoritative_role(p_user_id);\n\n  IF p_is_requester\n     AND v_role IN ('buyer'::public.user_role, 'seller'::public.user_role) THEN\n    RETURN CASE WHEN public.is_pro(p_user_id) THEN 10 ELSE 1 END;\n  END IF;\n\n  IF NOT p_is_requester AND v_role = 'agent'::public.user_role THEN\n    RETURN CASE WHEN public.is_pro(p_user_id) THEN 10 ELSE 3 END;\n  END IF;\n\n  IF NOT p_is_requester AND v_role = 'seller'::public.user_role THEN\n    RETURN 999;\n  END IF;\n\n  IF v_role IS NULL THEN\n    RETURN 0;\n  END IF;\n\n  RETURN 999;\nEND;\n", "definition" : "CREATE OR REPLACE FUNCTION public.get_viewing_limit(p_user_id uuid, p_is_requester boolean)\n RETURNS integer\n LANGUAGE plpgsql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\nDECLARE\n  v_role public.user_role;\nBEGIN\n  v_role := private.authoritative_role(p_user_id);\n\n  IF p_is_requester\n     AND v_role IN ('buyer'::public.user_role, 'seller'::public.user_role) THEN\n    RETURN CASE WHEN public.is_pro(p_user_id) THEN 10 ELSE 1 END;\n  END IF;\n\n  IF NOT p_is_requester AND v_role = 'agent'::public.user_role THEN\n    RETURN CASE WHEN public.is_pro(p_user_id) THEN 10 ELSE 3 END;\n  END IF;\n\n  IF NOT p_is_requester AND v_role = 'seller'::public.user_role THEN\n    RETURN 999;\n  END IF;\n\n  IF v_role IS NULL THEN\n    RETURN 0;\n  END IF;\n\n  RETURN 999;\nEND;\n$function$\n"}, {"schema" : "public", "signature" : "guard_viewing_status_transitions()", "name" : "guard_viewing_status_transitions", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=public, pg_temp"], "body" : "\nDECLARE\n  v_actor uuid := (SELECT auth.uid());\nBEGIN\n  IF v_actor IS NULL THEN\n    RETURN NEW;\n  END IF;\n\n  IF NEW.id IS DISTINCT FROM OLD.id\n     OR NEW.owner_id IS DISTINCT FROM OLD.owner_id\n     OR NEW.requester_id IS DISTINCT FROM OLD.requester_id\n     OR NEW.listing_id IS DISTINCT FROM OLD.listing_id\n     OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN\n    RAISE EXCEPTION 'viewing identity cannot be changed'\n      USING ERRCODE = '42501';\n  END IF;\n\n  IF v_actor = OLD.owner_id THEN\n    IF NEW.status IS DISTINCT FROM OLD.status\n       AND NOT (\n         (OLD.status = 'pending' AND NEW.status IN ('confirmed', 'cancelled'))\n         OR (OLD.status = 'confirmed' AND NEW.status IN ('completed', 'cancelled'))\n       ) THEN\n      RAISE EXCEPTION 'invalid listing-owner viewing status transition'\n        USING ERRCODE = '42501';\n    END IF;\n\n    RETURN NEW;\n  END IF;\n\n  IF v_actor = OLD.requester_id THEN\n    IF NEW.scheduled_at IS DISTINCT FROM OLD.scheduled_at\n       OR NEW.viewing_type IS DISTINCT FROM OLD.viewing_type\n       OR NEW.video_link IS DISTINCT FROM OLD.video_link\n       OR NEW.note IS DISTINCT FROM OLD.note THEN\n      RAISE EXCEPTION 'only the listing owner can manage viewing host details'\n        USING ERRCODE = '42501';\n    END IF;\n\n    IF NEW.status IS DISTINCT FROM OLD.status\n       AND NOT (\n         OLD.status IN ('pending', 'confirmed')\n         AND NEW.status = 'cancelled'\n       ) THEN\n      RAISE EXCEPTION 'requesters may only cancel an active viewing request'\n        USING ERRCODE = '42501';\n    END IF;\n\n    RETURN NEW;\n  END IF;\n\n  RAISE EXCEPTION 'only viewing participants may update a viewing'\n    USING ERRCODE = '42501';\nEND;\n", "definition" : "CREATE OR REPLACE FUNCTION public.guard_viewing_status_transitions()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nDECLARE\n  v_actor uuid := (SELECT auth.uid());\nBEGIN\n  IF v_actor IS NULL THEN\n    RETURN NEW;\n  END IF;\n\n  IF NEW.id IS DISTINCT FROM OLD.id\n     OR NEW.owner_id IS DISTINCT FROM OLD.owner_id\n     OR NEW.requester_id IS DISTINCT FROM OLD.requester_id\n     OR NEW.listing_id IS DISTINCT FROM OLD.listing_id\n     OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN\n    RAISE EXCEPTION 'viewing identity cannot be changed'\n      USING ERRCODE = '42501';\n  END IF;\n\n  IF v_actor = OLD.owner_id THEN\n    IF NEW.status IS DISTINCT FROM OLD.status\n       AND NOT (\n         (OLD.status = 'pending' AND NEW.status IN ('confirmed', 'cancelled'))\n         OR (OLD.status = 'confirmed' AND NEW.status IN ('completed', 'cancelled'))\n       ) THEN\n      RAISE EXCEPTION 'invalid listing-owner viewing status transition'\n        USING ERRCODE = '42501';\n    END IF;\n\n    RETURN NEW;\n  END IF;\n\n  IF v_actor = OLD.requester_id THEN\n    IF NEW.scheduled_at IS DISTINCT FROM OLD.scheduled_at\n       OR NEW.viewing_type IS DISTINCT FROM OLD.viewing_type\n       OR NEW.video_link IS DISTINCT FROM OLD.video_link\n       OR NEW.note IS DISTINCT FROM OLD.note THEN\n      RAISE EXCEPTION 'only the listing owner can manage viewing host details'\n        USING ERRCODE = '42501';\n    END IF;\n\n    IF NEW.status IS DISTINCT FROM OLD.status\n       AND NOT (\n         OLD.status IN ('pending', 'confirmed')\n         AND NEW.status = 'cancelled'\n       ) THEN\n      RAISE EXCEPTION 'requesters may only cancel an active viewing request'\n        USING ERRCODE = '42501';\n    END IF;\n\n    RETURN NEW;\n  END IF;\n\n  RAISE EXCEPTION 'only viewing participants may update a viewing'\n    USING ERRCODE = '42501';\nEND;\n$function$\n"}, {"schema" : "public", "signature" : "has_platform_admin(uuid)", "name" : "has_platform_admin", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=public"], "body" : "\n  SELECT public.authoritative_role(_user_id) = 'admin'::public.user_role\n", "definition" : "CREATE OR REPLACE FUNCTION public.has_platform_admin(_user_id uuid DEFAULT auth.uid())\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n  SELECT public.authoritative_role(_user_id) = 'admin'::public.user_role\n$function$\n"}, {"schema" : "public", "signature" : "is_pro(uuid)", "name" : "is_pro", "owner" : "postgres", "acl" : ["postgres=X/postgres","service_role=X/postgres"], "security_definer" : true, "config" : ["search_path=pg_catalog, public, private"], "body" : "\n  SELECT\n    public.has_platform_admin(p_user_id)\n    OR COALESCE(\n      (\n        SELECT\n          profile.role_switch_in_progress_at IS NULL\n          AND profile.force_pro_access\n        FROM public.profiles AS profile\n        WHERE profile.user_id = p_user_id\n        LIMIT 1\n      ),\n      FALSE\n    )\n    OR private.has_current_billing_subscription_for_user(p_user_id)\n    OR private.has_investor_subscription_for_user(p_user_id)\n", "definition" : "CREATE OR REPLACE FUNCTION public.is_pro(p_user_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'pg_catalog', 'public', 'private'\nAS $function$\n  SELECT\n    public.has_platform_admin(p_user_id)\n    OR COALESCE(\n      (\n        SELECT\n          profile.role_switch_in_progress_at IS NULL\n          AND profile.force_pro_access\n        FROM public.profiles AS profile\n        WHERE profile.user_id = p_user_id\n        LIMIT 1\n      ),\n      FALSE\n    )\n    OR private.has_current_billing_subscription_for_user(p_user_id)\n    OR private.has_investor_subscription_for_user(p_user_id)\n$function$\n"}, {"schema" : "public", "signature" : "profile_pricing_audience(user_role,text)", "name" : "profile_pricing_audience", "owner" : "postgres", "acl" : ["postgres=X/postgres","authenticated=X/postgres","service_role=X/postgres"], "security_definer" : false, "config" : ["search_path=public"], "body" : "\n  SELECT CASE\n    WHEN p_role IN ('buyer'::public.user_role, 'seller'::public.user_role) THEN 'participant'\n    WHEN p_role IN (\n      'agent'::public.user_role,\n      'developer'::public.user_role,\n      'professional'::public.user_role,\n      'investor'::public.user_role,\n      'institutional'::public.user_role\n    ) THEN p_role::text\n    WHEN p_role = 'admin'::public.user_role THEN 'agent'\n    WHEN p_role IS NULL AND p_participant_type IN ('buyer', 'seller', 'participant', 'pro', 'user') THEN 'participant'\n    ELSE NULL\n  END\n", "definition" : "CREATE OR REPLACE FUNCTION public.profile_pricing_audience(p_role user_role, p_participant_type text DEFAULT NULL::text)\n RETURNS text\n LANGUAGE sql\n IMMUTABLE\n SET search_path TO 'public'\nAS $function$\n  SELECT CASE\n    WHEN p_role IN ('buyer'::public.user_role, 'seller'::public.user_role) THEN 'participant'\n    WHEN p_role IN (\n      'agent'::public.user_role,\n      'developer'::public.user_role,\n      'professional'::public.user_role,\n      'investor'::public.user_role,\n      'institutional'::public.user_role\n    ) THEN p_role::text\n    WHEN p_role = 'admin'::public.user_role THEN 'agent'\n    WHEN p_role IS NULL AND p_participant_type IN ('buyer', 'seller', 'participant', 'pro', 'user') THEN 'participant'\n    ELSE NULL\n  END\n$function$\n"}, {"schema" : "public", "signature" : "update_updated_at_column()", "name" : "update_updated_at_column", "owner" : "postgres", "acl" : null, "security_definer" : false, "config" : ["search_path=public"], "body" : "\nBEGIN NEW.updated_at = now(); RETURN NEW; END;\n", "definition" : "CREATE OR REPLACE FUNCTION public.update_updated_at_column()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nBEGIN NEW.updated_at = now(); RETURN NEW; END;\n$function$\n"}], "schemas" : [{"name" : "private", "owner" : "postgres", "acl" : ["postgres=UC/postgres","authenticated=U/postgres","service_role=U/postgres"]}, {"name" : "public", "owner" : "pg_database_owner", "acl" : ["pg_database_owner=UC/pg_database_owner","=U/pg_database_owner","anon=U/pg_database_owner","authenticated=U/pg_database_owner","service_role=U/pg_database_owner"]}], "access" : {"viewing_insert" : true, "viewing_select" : true, "listing_id_select" : false, "listing_owner_select" : false}}
