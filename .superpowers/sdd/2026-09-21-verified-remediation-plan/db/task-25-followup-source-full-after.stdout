PRIMARY KEY (id)", "CHECK (priority_placement = ANY (ARRAY[0, 1]))", "CHECK (project_id IS NULL OR listing_type = 'new_build'::listing_type)", "FOREIGN KEY (project_id) REFERENCES projects(id) ON DELETE SET NULL", "CHECK (safety_score >= 0 AND safety_score <= 100)", "CHECK (organization_id IS NULL OR owner_id IS NOT NULL)", "CHECK (walkability_score >= 0 AND walkability_score <= 100)"]}, {"name" : "viewings", "owner" : "postgres", "rls" : true, "force_rls" : false, "acl" : ["postgres=arwdDxt/postgres","authenticated=arw/postgres","anon=arw/postgres"], "columns" : [{"name" : "id", "type" : "uuid", "notnull" : true, "acl" : null, "default" : "gen_random_uuid()"}, {"name" : "listing_id", "type" : "uuid", "notnull" : true, "acl" : null, "default" : null}, {"name" : "requester_id", "type" : "uuid", "notnull" : true, "acl" : null, "default" : null}, {"name" : "owner_id", "type" : "uuid", "notnull" : true, "acl" : null, "default" : null}, {"name" : "viewing_type", "type" : "viewing_type", "notnull" : true, "acl" : null, "default" : "'in_person'::viewing_type"}, {"name" : "status", "type" : "viewing_status", "notnull" : true, "acl" : null, "default" : "'pending'::viewing_status"}, {"name" : "scheduled_at", "type" : "timestamp with time zone", "notnull" : true, "acl" : null, "default" : null}, {"name" : "note", "type" : "text", "notnull" : false, "acl" : null, "default" : null}, {"name" : "video_link", "type" : "text", "notnull" : false, "acl" : null, "default" : null}, {"name" : "created_at", "type" : "timestamp with time zone", "notnull" : true, "acl" : null, "default" : "now()"}, {"name" : "updated_at", "type" : "timestamp with time zone", "notnull" : true, "acl" : null, "default" : "now()"}], "constraints" : ["FOREIGN KEY (listing_id) REFERENCES listings(id) ON DELETE CASCADE", "FOREIGN KEY (owner_id) REFERENCES auth.users(id) ON DELETE CASCADE", "PRIMARY KEY (id)", "FOREIGN KEY (requester_id) REFERENCES auth.users(id) ON DELETE CASCADE"]}], "triggers" : [{"table" : "vie