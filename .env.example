# Supabase (required for the app to start)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Optional: Mapbox (for map components)
# VITE_MAPBOX_TOKEN=pk....

# Optional: Stripe
# Product ID — used to verify active subscriptions (falls back to hardcoded if not set)
# VITE_STRIPE_PRO_PRODUCT_ID=prod_...
#
# Stripe Price IDs — required for per-role checkout and role-switch billing warnings.
# Find these in your Stripe dashboard under Products → [plan] → Prices.
# Without these, checkout will fall back to plan keys resolved server-side in create-checkout.
# VITE_STRIPE_PRICE_PARTICIPANT_MONTHLY=price_...
# VITE_STRIPE_PRICE_PARTICIPANT_ANNUAL=price_...
# VITE_STRIPE_PRICE_AGENT_MONTHLY=price_...
# VITE_STRIPE_PRICE_AGENT_ANNUAL=price_...
# VITE_STRIPE_PRICE_DEVELOPER_MONTHLY=price_...
# VITE_STRIPE_PRICE_DEVELOPER_ANNUAL=price_...
# VITE_STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
# VITE_STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_...

# Optional: Sentry error monitoring + performance tracing
# VITE_SENTRY_DSN=https://xxx@oYYY.ingest.sentry.io/ZZZ

# Optional: Plausible analytics (GDPR-compliant, no cookies)
# Set to your site domain, e.g. maiprop.co — script is only injected after analytics consent
# VITE_PLAUSIBLE_DOMAIN=maiprop.co

# Optional: Google Maps / Street View (for map and auction card fallback images)
# VITE_GOOGLE_MAPS_API_KEY=your-google-api-key
# VITE_GOOGLE_STREETVIEW_KEY=your-google-api-key
