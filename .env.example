# Supabase (required for the app to start)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Optional: Mapbox (for map components)
# VITE_MAPBOX_TOKEN=pk....

# Optional: Google Maps / Street View (for map and auction card fallback images)
# VITE_GOOGLE_MAPS_API_KEY=your-google-api-key
# VITE_GOOGLE_STREETVIEW_KEY=your-google-api-key
