# Supabase (required for the app to start)
# Use the project URL, or an activated Supabase custom domain such as
# https://auth.example.com when you want Google OAuth to show a branded callback host.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Optional: Mapbox (for map components)
# VITE_MAPBOX_TOKEN=pk....

# Server-side edge function secrets are configured in Supabase, not here.
# Relevant secrets now include:
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
# OPENAI_REASONING_EFFORT=medium
# BREVO_API_KEY=xkeysib-...
# BREVO_FROM_EMAIL=alerts@maiprop.co
# BREVO_FROM_NAME=maiProp
# SEND_EMAIL_HOOK_SECRET=v1,whsec_...
# EMAIL_TEMPLATE_PREVIEW_SECRET=optional-preview-secret

# Optional: Stripe
# Product ID — used to verify active subscriptions (falls back to hardcoded if not set)
# VITE_STRIPE_PRO_PRODUCT_ID=prod_...
#
# Stripe Price IDs — required for per-role checkout and role-switch billing warnings.
# Find these in your Stripe dashboard under Products → [plan] → Prices.
# Without these, checkout will fall back to plan keys resolved server-side in create-checkout.
# IMPORTANT: Replace these placeholder Price IDs with real ones from your Stripe dashboard.
# Until then, checkout will fall back to plan keys resolved server-side in create-checkout.
VITE_STRIPE_PRICE_PARTICIPANT_MONTHLY=price_placeholder_participant_mo_29eur
VITE_STRIPE_PRICE_PARTICIPANT_ANNUAL=price_placeholder_participant_yr_290eur
VITE_STRIPE_PRICE_AGENT_MONTHLY=price_placeholder_agent_mo_149eur
VITE_STRIPE_PRICE_AGENT_ANNUAL=price_placeholder_agent_yr_1490eur
VITE_STRIPE_PRICE_DEVELOPER_MONTHLY=price_placeholder_developer_mo_129eur
VITE_STRIPE_PRICE_DEVELOPER_ANNUAL=price_placeholder_developer_yr_1290eur
VITE_STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_placeholder_professional_mo_69eur
VITE_STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_placeholder_professional_yr_690eur

# Optional: Sentry error monitoring + performance tracing
# Frontend (browser) — exposed to the bundle, must be the public DSN.
# VITE_SENTRY_DSN=https://xxx@oYYY.ingest.sentry.io/ZZZ
#
# Edge functions (server side) — set in Supabase secrets, NOT here.
# When SENTRY_DSN is present, every log.error(...) call in the edge functions
# is auto-forwarded to Sentry's HTTP store API (no SDK, fire-and-forget).
# Optional ENVIRONMENT tag for grouping (e.g. "production"/"staging"); defaults
# to "production" in deployed functions.
# SENTRY_DSN=https://xxx@oYYY.ingest.sentry.io/ZZZ
# ENVIRONMENT=production

# Optional: Plausible analytics (GDPR-compliant, no cookies)
# Set to your site domain, e.g. maiprop.co — script is only injected after analytics consent
# VITE_PLAUSIBLE_DOMAIN=maiprop.co

# Optional: Google Maps / Street View (for map and auction card fallback images)
# VITE_GOOGLE_MAPS_API_KEY=your-google-api-key

# Optional: listing-view sampling. Defaults to 1, meaning every listing view is tracked.
# Set lower values such as 0.2 to sample high-traffic environments.
# VITE_VIEW_TRACKING_SAMPLE_RATE=1
# VIEW_TRACKING_SAMPLE_RATE=1

# Optional: TURN relay for built-in mAI prop video rooms.
# Leave unset for STUN-only peer-to-peer calls; set all three when using a managed TURN service.
# VITE_MAIPROP_TURN_URLS=turns:turn.example.com:5349,turn:turn.example.com:3478
# VITE_MAIPROP_TURN_USERNAME=turn-user
# VITE_MAIPROP_TURN_CREDENTIAL=turn-password
#
# Optional: require Supabase private Realtime channel authorization for video-room signaling.
# Leave false unless realtime.messages policies have been verified on the linked project.
# VITE_MAIPROP_PRIVATE_VIDEO_ROOMS=false

# Optional: live/staging Playwright E2E controls.
# PLAYWRIGHT_BASE_URL=https://portal.maiprop.co
# E2E_RUN_SUPERVISOR_NETWORK=false

# Supabase edge-function secrets (configure in Supabase, never with VITE_)
# MAIPROP_OS_URL=https://os.example.com
# MAIPROP_OS_EMAIL=integration-user@example.com
# MAIPROP_OS_PASSWORD=...
# MAIPROP_OS_WEBHOOK_SECRET=...
# GOOGLE_MAPS_API_KEY=server-side-google-api-key
# CRON_SECRET=...
# WEBHOOK_SECRET=...
# STRIPE_SECRET_KEY=sk_live_or_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_DEFAULT=price_...
# SITE_URL=https://portal.maiprop.co/
# MAIPROP_APP_URL=https://portal.maiprop.co/
# HEALTHZ_MONITOR_SECRET=long-random-token-for-detailed-health-checks
