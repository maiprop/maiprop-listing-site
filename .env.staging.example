# ── Staging environment variables ─────────────────────────────────────────────
# Copy this to .env.staging (gitignored) and fill in your staging Supabase project.
#
# How to create a staging Supabase project:
#   1. Go to https://supabase.com/dashboard and create a new project, e.g. "maiprop-staging"
#   2. Run `supabase link --project-ref <staging-ref>` then `supabase db push` to mirror the schema
#   3. Deploy edge functions: `supabase functions deploy --project-ref <staging-ref>`
#   4. Add all variables below to Netlify → Site settings → Environment variables
#      scoped to the `staging` branch
#
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://<staging-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<staging-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<staging-anon-key>

# Optional — use staging-specific keys so test traffic stays separate
VITE_TURNSTILE_SITE_KEY=<staging-turnstile-key>
VITE_MAPBOX_TOKEN=<mapbox-token>
VITE_SENTRY_DSN=<staging-sentry-dsn>
VITE_STRIPE_PRO_PRODUCT_ID=<staging-stripe-product-id>

# Override app origin so OAuth redirects go to the staging URL
VITE_APP_URL=https://staging--maiprop.netlify.app
