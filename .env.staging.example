# ── Staging environment variables ─────────────────────────────────────────────
# This is a cross-provider inventory for local development, GitHub Actions,
# Cloudflare Pages, Supabase Edge Functions, and Stripe test mode. Copy it to
# .env.staging (gitignored) only for local setup, then fill in staging values.
# Do not bulk-copy this file into Cloudflare Pages. The release validator rejects
# every runtime binding outside the exact allowlist documented in STAGING_SETUP.md.
#
# How to provision the isolated staging environment:
#   1. Go to https://supabase.com/dashboard and create a new project, e.g. "maiprop-staging"
#   2. Configure the GitHub staging environment and repository metadata described
#      in docs/STAGING_SETUP.md; do not deploy schema or functions manually.
#   3. Pre-create the dedicated staging Pages project and add only the strict
#      Pages runtime allowlist described in docs/STAGING_SETUP.md.
#   4. Let the exact-SHA signed release workflows apply Supabase migrations,
#      deploy Edge Functions, and deploy branch main to staging infrastructure.
#
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_URL=https://<staging-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<staging-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<staging-anon-key>
# GitHub staging-release target guard. Configure both as repository metadata;
# they are project references, not credentials, and must never be equal.
STAGING_SUPABASE_PROJECT_ID=<staging-ref>
PRODUCTION_SUPABASE_PROJECT_ID=qvvicunqcrwpioqnvzxf
# Keep the automatic release train disabled until every staging prerequisite
# and exact-SHA proof is ready. The acknowledgement is a non-secret repository
# variable and must match the dedicated MaiProp staging project exactly.
STAGING_RELEASE_ENABLED=false
# One-time manual Pages bootstrap remains separately disabled after the first
# successful function-enabled canonical deployment.
STAGING_PAGES_BOOTSTRAP_ENABLED=false
# Manual trust pin for the reviewed `main` commit containing the staging control
# workflows. Staging stays disabled unless this full SHA equals both the
# workflow file SHA and the exact release SHA.
# STAGING_TRUSTED_CONTROL_SHA=<40-character-reviewed-main-sha>
# STAGING_MUTATION_ACKNOWLEDGEMENT=MUTATE_STAGING_xsiehskfgeoqyazcgauv
# Optional legacy alias for tooling that still reads the old anon-key name.
# Prefer VITE_SUPABASE_PUBLISHABLE_KEY for new configuration.
# VITE_SUPABASE_ANON_KEY=<staging-anon-key>

# GitHub Actions only: optional percent-encoded staging Postgres connection string
# for automatic staging DB migration pushes. Only set this for an isolated
# non-production staging project. Do not expose this in Cloudflare Pages.
SUPABASE_STAGING_DB_URL=postgresql://postgres.<staging-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# GitHub Actions / local staging tenant-matrix identities. These accounts must
# be seeded in the isolated staging Auth project and must never be production users.
STAGING_DEMO_PASSWORD=<staging-demo-password>
STAGING_DEVELOPER_A_EMAIL=developer.pro@maiprop.demo
STAGING_DEVELOPER_B_EMAIL=agent.pro@maiprop.demo
STAGING_DEVELOPER_FREE_EMAIL=developer.free@maiprop.demo
STAGING_SELLER_FREE_EMAIL=seller.free@maiprop.demo
# Exact-SHA live security proof. The admin must be pre-provisioned as a
# platform admin in the isolated staging project; the workflow never elevates it.
E2E_ADMIN_EMAIL=<staging-platform-admin-email>
E2E_ADMIN_PASSWORD=<staging-platform-admin-password>

# GitHub Actions generated at runtime after resolving the staging DB URL.
# Do not set this manually in Cloudflare Pages or local shells.
# SUPABASE_STAGING_EFFECTIVE_DB_URL=postgresql://postgres.<staging-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Optional — use staging-specific keys so test traffic stays separate
VITE_TURNSTILE_SITE_KEY=<staging-turnstile-key>

# Cloudflare Pages server-only TURN credential issuer.
CLOUDFLARE_TURN_KEY_ID=<staging-turn-key-id>
CLOUDFLARE_TURN_API_TOKEN=<staging-turn-api-token>
MAIPROP_TURN_TTL_SECONDS=21600
VITE_MAPBOX_TOKEN=<mapbox-token>
VITE_SENTRY_DSN=<staging-sentry-dsn>
# Stripe is optional in staging. If enabled, use only test-mode browser values.
# The release train rejects pk_live_*, live modes, and any Pages price ID also
# configured on the production Pages project.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_<staging-publishable-key>
VITE_STRIPE_RUNTIME_MODE=test
VITE_BILLING_MODE=test
VITE_STRIPE_PRO_PRODUCT_ID=<staging-stripe-product-id>
VITE_STRIPE_PRICE_PARTICIPANT_MONTHLY=<staging-price-id>
VITE_STRIPE_PRICE_PARTICIPANT_ANNUAL=<staging-price-id>
VITE_STRIPE_PRICE_AGENT_MONTHLY=<staging-price-id>
VITE_STRIPE_PRICE_AGENT_ANNUAL=<staging-price-id>
VITE_STRIPE_PRICE_DEVELOPER_MONTHLY=<staging-price-id>
VITE_STRIPE_PRICE_DEVELOPER_ANNUAL=<staging-price-id>
VITE_STRIPE_PRICE_PROFESSIONAL_MONTHLY=<staging-price-id>
VITE_STRIPE_PRICE_PROFESSIONAL_ANNUAL=<staging-price-id>
VITE_GOOGLE_MAPS_API_KEY=<staging-google-maps-key>
VITE_ENABLE_GOOGLE_PLACES_AUTOCOMPLETE=false
VITE_WEB_VITALS_SAMPLE_RATE=0.1

# Override app origin so OAuth redirects go to the staging URL.
# Dedicated staging Pages production origin (not a production-project preview).
VITE_APP_URL=https://maiprop-listing-site-staging.pages.dev

# Optional: absolute origin for cached public API routes when testing a bundled
# Capacitor app against staging. Native HTTP uses this value; browser previews
# ignore it and use same-origin /api paths.
VITE_PUBLIC_API_ORIGIN=https://maiprop-listing-site-staging.pages.dev

# Optional Cloudflare Pages runtime passcode. Pre-provision this only as an
# encrypted secret_text binding; the strict release allowlist rejects plaintext.
# SITE_LOCK_PASSWORD=<staging-site-lock-password>

# Supabase edge-function secrets for staging (configure in Supabase).
# SUPABASE_URL=https://<staging-ref>.supabase.co
# SUPABASE_ANON_KEY=<staging-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<staging-service-role-key>
# GEMINI_API_KEY=<staging-gemini-key>
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TRANSLATION_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=<staging-openai-key>
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_TRANSLATION_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=medium
# STRIPE_RUNTIME_MODE=test
# STRIPE_ENVIRONMENT= # legacy alias for STRIPE_RUNTIME_MODE; leave unset
# STRIPE_RUN_MODE= # legacy alias for STRIPE_RUNTIME_MODE; leave unset
# STRIPE_LIVE_MODE=false
# Stripe account routing. These IDs are not secrets. Staging must use the
# sandbox account, not the live mAI prop billing account.
# STRIPE_TEST_ACCOUNT_ID=acct_1TnuLbGfkWWBWEyh # mAI prop sandbox
# STRIPE_LIVE_ACCOUNT_ID=acct_1TnuLTGfOEgBOxtl # mAI prop
# STRIPE_EXPECTED_ACCOUNT_ID=acct_1TnuLbGfkWWBWEyh
# STRIPE_API_VERSION=2026-06-24.dahlia
# STRIPE_PRODUCT_TAX_CODE=txcd_10000000
# STRIPE_SAAS_PERSONAL_TAX_CODE=txcd_10103000
# STRIPE_SAAS_BUSINESS_TAX_CODE=txcd_10103001
# STRIPE_AI_PERSONAL_TAX_CODE=txcd_10105001
# STRIPE_AI_BUSINESS_TAX_CODE=txcd_10105002
# STRIPE_TAX_BEHAVIOR=exclusive
# STRIPE_SECRET_KEY=<staging-stripe-test-secret>
# STRIPE_API_KEY=<staging-stripe-test-secret> # local Stripe scripts only; prefer STRIPE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET=<staging-stripe-webhook-secret>
# STRIPE_CUSTOMER_PORTAL_CONFIGURATION_ID=<staging-stripe-portal-config-id>
# STRIPE_PRICE_DEFAULT=<staging-price-id>
# STRIPE_TAX_EXPECT_COUNTRY=GR
# STRIPE_TAX_EXPECT_RATE=0.24
# STRIPE_TAX_CHECK_INVOICE=<staging-invoice-id>
# STRIPE_TAX_READINESS_STRICT=true
# Optional server-side price fallbacks. Prefer Admin Pricing sync, which stores
# these IDs in pricing_configs.metadata and keeps monthly/annual IDs distinct.
# STRIPE_PRICE_PARTICIPANT_MONTHLY=<staging-price-id>
# STRIPE_PRICE_PARTICIPANT_ANNUAL=<staging-price-id>
# STRIPE_PRICE_AGENT_MONTHLY=<staging-price-id>
# STRIPE_PRICE_AGENT_ANNUAL=<staging-price-id>
# STRIPE_PRICE_DEVELOPER_MONTHLY=<staging-price-id>
# STRIPE_PRICE_DEVELOPER_ANNUAL=<staging-price-id>
# STRIPE_PRICE_PROFESSIONAL_MONTHLY=<staging-price-id>
# STRIPE_PRICE_PROFESSIONAL_ANNUAL=<staging-price-id>
# AUTH_VERIFY_TIMEOUT_MS=5000
# RATE_LIMIT_DB_TIMEOUT_MS=2500
# BREVO_API_KEY=<staging-brevo-key>
# BREVO_FROM_EMAIL=alerts-staging@maiprop.co
# BREVO_FROM_NAME=maiProp Staging
# SEND_EMAIL_HOOK_SECRET=<staging-hook-secret>
# EMAIL_TEMPLATE_PREVIEW_SECRET=<staging-preview-secret>
# SENTRY_DSN=<staging-edge-sentry-dsn>
# ENVIRONMENT=staging
# CRON_SECRET=<staging-cron-secret>
# WEBHOOK_SECRET=<staging-registration-webhook-secret>
# MAIPROP_APP_URL=https://maiprop-listing-site-staging.pages.dev
# SITE_URL=https://maiprop-listing-site-staging.pages.dev
# MAIPROP_OS_URL=<staging-os-url>
# MAIPROP_OS_API_URL=<staging-os-api-url>
# MAIPROP_OS_EMAIL=<staging-os-email>
# MAIPROP_OS_PASSWORD=<staging-os-password>
# MAIPROP_OS_WEBHOOK_SECRET=<staging-os-webhook-secret>
# MAIPROP_OS_PAST_DEALS_PATH=/api/v1/auctions/:id/past-deals
# MAIPROP_OS_REPORT_PATH=/api/v1/reports/listing
# GOOGLE_MAPS_API_KEY=<server-side-google-maps-key>
