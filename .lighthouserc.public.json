{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4173",
      "startServerReadyPattern": "Local|Network|ready|listen",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/listings",
        "http://localhost:4173/auctions",
        "http://localhost:4173/open-houses",
        "http://localhost:4173/professionals",
        "http://localhost:4173/pricing",
        "http://localhost:4173/login",
        "http://localhost:4173/property/lighthouse-smoke-property"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "chromeFlags": ["--no-sandbox"],
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "skipAudits": ["uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.75 }],
        "categories:accessibility": ["error", { "minScore": 0.90 }],
        "categories:best-practices": ["error", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.90 }],
        "first-contentful-paint": ["error", { "maxNumericValue": 2200 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3500 }],
        "total-blocking-time": ["error", { "maxNumericValue": 400 }],
        "max-potential-fid": ["error", { "maxNumericValue": 200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "unused-javascript": "off",
        "unused-css-rules": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
